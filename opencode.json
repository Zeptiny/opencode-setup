{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "summary": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "title": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "compaction": {
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/compaction.txt}"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": { "limit": { "context": 1000000, "output": 384000  } },
        "deepseek-v4-pro":   { "limit": { "context": 262144, "output": 384000  } },
        "glm-5":             { "limit": { "context": 262144, "output": 32768   } },
        "glm-5.1":           { "limit": { "context": 262144, "output": 32768   } },
        "kimi-k2.5":         { "limit": { "context": 262144, "output": 65536   } },
        "kimi-k2.6":         { "limit": { "context": 262144, "output": 65536   } },
        "mimo-v2-omni":      { "limit": { "context": 262144, "output": 128000  } },
        "mimo-v2-pro":       { "limit": { "context": 262144, "output": 128000  } },
        "mimo-v2.5":         { "limit": { "context": 262144, "output": 128000  } },
        "mimo-v2.5-pro":     { "limit": { "context": 262144, "output": 128000  } },
        "minimax-m2.5":      { "limit": { "context": 204800, "output": 65536   } },
        "minimax-m2.7":      { "limit": { "context": 204800, "output": 131072  } },
        "qwen3.5-plus":      { "limit": { "context": 262144, "output": 65536   } },
        "qwen3.6-plus":      { "limit": { "context": 262144, "output": 65536   } }
      }
    }
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer <CHANGE-ME>"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "webfetch": "deny"
  },
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    }
  }

}
